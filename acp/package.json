{
  "name": "@jeremy9682/dsh-acp",
  "version": "0.1.0",
  "description": "DeepSeek Harness ACP bundle for editor delegation: a one-command Agent Client Protocol stdio server profile that shares dsh credentials and session logs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy9682/dsh-cursor-codex.git",
    "directory": "acp"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "acp",
    "agent-client-protocol"
  ],
  "bin": {
